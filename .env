# Server
PORT=4173
NODE_ENV=development
PUBLIC_BASE_URL=http://localhost:4173

# Google OAuth web application credentials (Google Sign-In only; no Gmail inbox access).
# Configure the exact callback URL in Google Cloud Console.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:4173/auth/google/callback
# Generate at least 32 random bytes, for example: openssl rand -hex 32
KAM_SESSION_SECRET=
# Optional: override where local JSON data is stored
# KAM_DATA_DIR=./data

# PriceLens is the live product-price aggregator connector.
# Keep this key on the server. Never put it in public/app.js.
PRICELENS_API_KEY=
PRICELENS_BASE_URL=https://pricelens.store/api/v1/partner

# Admin moderation. Generate a long random value before deployment.
KAM_ADMIN_TOKEN=replace-with-a-long-random-secret

# Optional shared production database (Supabase Postgres REST API).
# If empty, KAM persists to ./data/kam-data.json for local single-server use.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
